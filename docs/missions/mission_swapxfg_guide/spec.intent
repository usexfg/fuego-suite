AIM: mission.swapxfg.guide#intent@2.2

INTENT SwapxfgUserGuide {
  SUMMARY: "A high-fidelity user guide for the SWAPXFG Cross-Chain Swap Terminal, covering setup, multi-chain connectivity, and swap operations."
  REQUIREMENTS {
    - "Explain the purpose of SWAPXFG as a unified TUI for atomic swaps."
    - "Detail command-line arguments for connecting to nodes and wallets."
    - "Provide a comprehensive reference of in-TUI commands (pair, offer, accept, connect, etc.)."
    - "Guide users through browser bridge connectivity (MetaMask/Phantom)."
    - "Explain the difference between soft orders and on-chain locked AFK offers."
    - "Adhere to the Fuego elite technical standard (no stubs, clean explanations)."
  }
  TESTS {
    - "Verify all documented commands exist in swapxfg/app/tui.go."
    - "Ensure setup instructions align with swapxfg/README.md and main.go flags."
  }
}
