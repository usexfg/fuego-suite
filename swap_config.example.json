{
  // ── Swap Daemon Chain Config ───────────────────────────────────────────────
  //
  // Each chain can run in one of several modes:
  //   SPV mode (BTC/LTC/KMD/BCH): light client, no full node needed.
  //   RPC mode (ETH/ARB/BASE/BSC/SOL): connect to any JSON-RPC endpoint.
  //
  // Generate a complete SPV config with fresh keys:
  //   xfg-swapd --generate-spv-config
  //
  // ── SPV Setup Summary ──
  // 1. Generate keys:    xfg-swapd --generate-spv-config > my-config.json
  // 2. Edit servers:     Replace the placeholder Electrum server addresses
  // 3. Fund addresses:   Send each chain's native token to the P2PKH address
  //                      shown in comments. The daemon needs funds for fees.
  // 4. Add XFG key:      Run `fire_wallet gen_swap_key` and paste the printed
  //                      secret key into `xfg_secret_key` below. Use a
  //                      dedicated swap key, not your wallet spend key.
  // 5. Run the daemon:   xfg-swapd --swap-config my-config.json --service
  //
  // ── EVM/Solana Light Client Setup ──
  // 1. Get a free RPC URL: Use LlamaRPC, Infura, Alchemy, or any public endpoint.
  // 2. Set your private key: 64-char hex (ETH/ARB/BASE/BSC) or base58 (SOL).
  // 3. Set *_host to the RPC endpoint hostname (no http:// prefix).
  // 4. No full node required — uses public infrastructure.

  // ── BTC ──
  // Full-node mode (the only mode that can start a swap): bitcoind with a
  // loaded wallet that holds private keys. -txindex is not required; the lock
  // is checked with gettxout and claims are found by scanning blocks.
  //   "btc_rpc_host": "127.0.0.1",
  //   "btc_rpc_port": 8332,
  //   "btc_rpc_user": "your_rpc_user",
  //   "btc_rpc_pass": "your_rpc_pass",
  //   "btc_network": "main",          // main | test | signet | regtest
  //   "btc_wif": "<compressed-key WIF for the same network>",
  //
  // SPV mode (cannot start new swaps; recovery of existing swaps only):
  "btc_mode": "spv",
  "btc_spv_server_0": "electrum.blockstream.info:50002",
  "btc_spv_min_servers": 1,
  "btc_spv_checkpoint_height": 800000,
  "btc_spv_checkpoint_hash": "00000000000000000002a7c4c1e8d3c5d5e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b",
  "btc_wif": "replace_with_your_btc_wif",  // P2PKH address: 1... (send BTC here)

  // ── LTC ──  (full node: ltc_rpc_host, ltc_rpc_port, ltc_rpc_user, ltc_rpc_pass, ltc_network)
  // "ltc_rpc_host": "127.0.0.1",
  // "ltc_rpc_port": 9332,
  "ltc_mode": "spv",
  "ltc_spv_server_0": "ltc.merkle.io:50002",
  "ltc_spv_min_servers": 1,
  "ltc_wif": "replace_with_your_ltc_wif",  // P2PKH address: L... (send LTC here)

  // ── KMD ──
  // "kmd_host": "127.0.0.1",
  // "kmd_port": 7771,
  "kmd_mode": "spv",
  "kmd_spv_server_0": "electrum1.cipig.net:10001",
  "kmd_spv_min_servers": 1,
  "kmd_wif": "replace_with_your_kmd_wif",  // P2PKH address: R... (send KMD here)

  // ── BCH ──  (full node: bch_rpc_host, bch_rpc_port, bch_rpc_user, bch_rpc_pass, bch_network)
  // "bch_rpc_host": "127.0.0.1",
  // "bch_rpc_port": 8332,
  "bch_mode": "spv",
  "bch_spv_server_0": "electroncash.org:50002",
  "bch_spv_min_servers": 1,
  "bch_wif": "replace_with_your_bch_wif",  // P2PKH address: 1... (send BCH here)

  // ── DCR ── (SPV is read-only; claim/refund needs RPC mode with dcrwallet)
  // "dcr_host": "127.0.0.1",
  // "dcr_port": 9108,
  // "dcr_rpc_user": "your_rpc_user",
  // "dcr_rpc_pass": "your_rpc_pass",
  "dcr_mode": "spv",
  "dcr_spv_server_0": "localhost:19100",
  "dcr_spv_min_servers": 1,
  "dcr_wif": "replace_with_your_dcr_wif",  // P2PKH address: D... (send DCR here)

  // ── XFG (Fuego) ─────────────────────────────────────────────────────────────
  // The XFG keypair the swap daemon signs offers and XFG swap outputs with.
  //
  // Generate a dedicated one (recommended — do NOT reuse your wallet spend key):
  //   fire_wallet gen_swap_key
  //
  // It also derives the swap database's at-rest encryption key, so changing it
  // later makes existing swap state unreadable. Back it up.
  "xfg_secret_key": "<your_xfg_secret_key_64_hex_chars>",

  // ── EVM chains ────────────────────────────────────────────────────────────
  // evm_chains is the only EVM config path; the flat eth_*/arb_*/... fields are
  // retired and refused by the loader. Keys are SwapPairCatalog config keys.
  // As shipped, each entry is a read-only client and reports not ready. To
  // lock funds, add to that entry:
  //   "private_key":   "<64_hex_private_key>",       // funded signer
  //   "address":       "<0x signer address>",        // set together with the key
  //   "htlc_registry": "<0x HashedTimelock on THIS chain>"   // optional, see below
  //   "ptlc_registry": "<0x PointTimelock on THIS chain>"    // optional
  // Without htlc_registry the canonical CREATE2 address applies (print it and its
  // deployment calldata with `xfg-swapd --print-htlc-deployment <HashedTimelock .bin>`);
  // readiness requires that address to hold exactly the committed HashedTimelock
  // runtime code. zkSync Era and Abstract (EraVM) need an explicit htlc_registry and
  // htlc_registry_code_hash. chain_id must equal the catalog value on mainnet.
  // GLEEC (gleec, 11169) and Robinhood Chain (rh, 4663) have no endpoint here: add
  // one you operate or trust. PEAQ parses, but new PEAQ swaps are refused: no
  // verified price feed. Delete unused entries.
  "evm_chains": {
    "eth":       { "rpc_url": "https://eth.llamarpc.com", "chain_id": 1 },
    "arb":       { "rpc_url": "https://arb1.arbitrum.io/rpc", "chain_id": 42161 },
    "base":      { "rpc_url": "https://mainnet.base.org", "chain_id": 8453 },
    "bsc":       { "rpc_url": "https://bsc-dataseed.binance.org", "chain_id": 56 },
    "poly":      { "rpc_url": "https://polygon-rpc.com", "chain_id": 137 },
    "avax":      { "rpc_url": "https://api.avax.network/ext/bc/C/rpc", "chain_id": 43114 },
    "cro":       { "rpc_url": "https://evm.cronos.org", "chain_id": 25 },
    "bob":       { "rpc_url": "https://rpc.gobob.xyz", "chain_id": 60808 },
    "uni":       { "rpc_url": "https://mainnet.unichain.org", "chain_id": 130 },
    "xpl":       { "rpc_url": "https://rpc.plasma.to", "chain_id": 9745 },
    "pls":       { "rpc_url": "https://rpc.pulsechain.com", "chain_id": 369 },
    "monad":     { "rpc_url": "https://rpc.monad.xyz", "chain_id": 143 },
    "op":        { "rpc_url": "https://mainnet.optimism.io", "chain_id": 10 },
    "linea":     { "rpc_url": "https://rpc.linea.build", "chain_id": 59144 },
    "zksync":    { "rpc_url": "https://mainnet.era.zksync.io", "chain_id": 324 },
    "hyperevm":  { "rpc_url": "https://rpc.hyperliquid.xyz/evm", "chain_id": 999 },
    "ink":       { "rpc_url": "https://rpc-gel.inkonchain.com", "chain_id": 57073 },
    "rsk":       { "rpc_url": "https://public-node.rsk.co", "chain_id": 30 },
    "gnosis":    { "rpc_url": "https://rpc.gnosischain.com", "chain_id": 100 },
    "flare":     { "rpc_url": "https://flare-api.flare.network/ext/C-rpc", "chain_id": 14 },
    "kaia":      { "rpc_url": "https://public-en.node.kaia.io", "chain_id": 8217 },
    "scroll":    { "rpc_url": "https://rpc.scroll.io", "chain_id": 534352 },
    "abstract":  { "rpc_url": "https://rpc.abstract.xyz", "chain_id": 2741 },
    "plume":     { "rpc_url": "https://rpc.plume.org", "chain_id": 98866 },
    "soneium":   { "rpc_url": "https://rpc.soneium.org", "chain_id": 1868 },
    "doma":      { "rpc_url": "https://rpc.doma.xyz", "chain_id": 97477 },
    "beam":      { "rpc_url": "https://build.onbeam.com/rpc", "chain_id": 4337 },
    "moonriver": { "rpc_url": "https://rpc.api.moonriver.moonbeam.network", "chain_id": 1285 },
    "peaq":      { "rpc_url": "https://peaq.api.onfinality.io/public", "chain_id": 3338 },
    "sei":       { "rpc_url": "https://evm-rpc.sei-apis.com", "chain_id": 1329 }
  },

  // DOGE — Dogecoin (port 22556)
  "doge_host": "127.0.0.1",
  "doge_port": 22556,
  "doge_wif": "<doge_wif>",
  // DASH — Dash (port 9998)
  "dash_host": "127.0.0.1",
  "dash_port": 9998,
  "dash_wif": "<dash_wif>",
  // ZEC — Zcash (port 8232)
  "zec_host": "127.0.0.1",
  "zec_port": 8232,
  "zec_wif": "<zec_wif>",
  // ZANO
  "zano_daemon_host": "127.0.0.1",
  "zano_daemon_port": 11211,
  "zano_spend_key": "<64_hex>",
  "zano_view_key": "<64_hex>",
  // TON
  "ton_host": "toncenter.com",
  "ton_port": 443,
  "ton_wallet_key": "<ed25519_seed_hex>",
  // SIA
  "sia_host": "127.0.0.1",
  "sia_port": 9980,
  "sia_api_password": "<sia_password>",
  // DOT — Polkadot (staged)
  "dot_host": "rpc.polkadot.io",
  "dot_port": 443,
  "dot_address": "<ss58_address>",

  // ── Price corroboration (optional) ────────────────────────────────────────
  // DeFiLlama and CoinGecko both resolve CoinGecko ids, so they are not
  // independent. Configure an EVM RPC and the Pyth price contract on that chain
  // to make Pyth the corroborating source instead of CoinGecko. All or none:
  //   "pyth_rpc_url":  "<https RPC of a chain where Pyth is deployed>",
  //   "pyth_contract": "<0x Pyth contract address on that chain>",
  //   "pyth_chain_id": <chain id>,

  // ── SOL (Solana — Light Client) ───────────────────────────────────────────
  // Connect to any Solana JSON-RPC endpoint. Public endpoints are free.
  "sol_mode": "rpc",
  "sol_host": "api.mainnet-beta.solana.com",
  "sol_port": 443,
  "sol_program_id": "65QnMn6ZM6GFpE7XkBPNqpFL2K4wKjJd1FpZvPzGqYJX",
  "sol_keypair_path": "/path/to/your/solana-keypair.json",

  // ── XMR (Monero RPC) ─────────────────────────────────────────────────────
  "xmr_daemon_host": "",
  "xmr_daemon_port": 18081,
  "xmr_wallet_host": "",
  "xmr_wallet_port": 18082,
  "xmr_spend_key": "",  // 64 hex chars
  "xmr_view_key": ""    // 64 hex chars
}
